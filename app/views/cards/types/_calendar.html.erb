<% event = card.payload %>
<div class="calendar-details">
  <p class="calendar-when"><%= Intake::When.describe(event) %></p>
  <% if event["location"].present? %><p class="hint"><%= event["location"] %></p><% end %>
  <% if event["conflicts"].present? %>
    <p class="calendar-conflicts">Clashes with <%= event["conflicts"].to_sentence %></p>
  <% end %>
  <% if event["html_link"].present? %>
    <p class="hint"><%= link_to "Meeting link", event["html_link"], target: "_blank", rel: "noopener" %></p>
  <% end %>
  <% if event["change"] == "invitation" %>
    <p class="hint">Answer it in Calendar<%= " (it covers the whole series)" if event["recurring"] %>. This card clears itself once your answer syncs.</p>
  <% end %>
</div>
<%= form_with url: reply_card_path(card), class: "tool" do |f| %>
  <%= f.submit event["change"] == "invitation" ? "Handled" : card.type.send_label, class: "tool-send" %>
<% end %>
