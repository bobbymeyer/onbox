<%= form_with url: reply_card_path(card), class: "tool tool-email" do |f| %>
  <%= f.label :text, "Reply to #{card.payload["reply_to"].presence || card.payload["from"]}", class: "tool-label" %>
  <%= f.text_area :text, value: card.proposed_action, placeholder: card.type.tool_placeholder, rows: 5 %>
  <%= f.submit card.type.send_label, class: "tool-send" %>
<% end %>
