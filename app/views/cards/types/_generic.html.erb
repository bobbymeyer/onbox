<%= form_with url: reply_card_path(card), class: "tool tool-generic" do |f| %>
  <%= f.label :text, card.type.tool_label, class: "tool-label" %>
  <%= f.text_area :text, value: card.proposed_action, placeholder: card.type.tool_placeholder, rows: 2 %>
  <%= f.submit card.type.send_label, class: "tool-send" %>
<% end %>
