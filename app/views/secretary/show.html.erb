<% content_for :title, "Secretary" %>
<main class="maintenance-view">
  <nav class="maint-nav"><%= link_to "← Stack", maintenance_path %></nav>
  <h1>Secretary</h1>
  <p class="hint">Routine duties run on a local model; deeper ones on Claude through your Claude login. Set with <code>STACK_SECRETARY</code> and <code>STACK_SECRETARY_DEEP</code>: local, claude_code, api or off.</p>

  <ul class="maint-list">
    <% { routine: "Card fronts, “later”, hourly and daily digests",
         deep: "Conversation, decompose, weekly and monthly digests" }.each do |tier, duties| %>
      <li class="maint-card">
        <div class="card-meta"><span class="card-source"><%= tier %></span><span><%= @tiers[tier] %></span></div>
        <p class="maint-summary"><%= duties %></p>
        <div class="maint-actions">
          <%= button_to "Test", test_secretary_path(tier: tier), disabled: @tiers[tier] == "off" %>
        </div>
      </li>
    <% end %>
  </ul>

  <% if @local %>
    <h2>Local model</h2>
    <div class="maint-card">
      <p class="maint-summary"><%= Secretary::Backends::Local.model %> at <%= Secretary::Backends::Local.url %></p>
      <% if !@local["reachable"] %>
        <p class="hint flash-alert">Ollama isn't reachable: <%= @local["error"] %>. Install it and run <code>ollama serve</code>.</p>
      <% elsif !@local["model_ready"] %>
        <p class="hint flash-alert">Model not pulled. Run <code>ollama pull <%= Secretary::Backends::Local.model %></code>, or set <code>STACK_LOCAL_MODEL</code> to one of: <%= @local["models"].join(", ").presence || "none installed" %>.</p>
      <% else %>
        <p class="hint">Ready.</p>
      <% end %>
    </div>
  <% end %>

  <h2>Claude</h2>
  <div class="maint-card">
    <p class="hint">Replies to Claude Code sessions<%= " and deep secretary duties" if @tiers.value?("claude_code") %> run through the <code>claude</code> CLI on your login, so they count against your Max plan.</p>
    <% if @claude.nil? %>
      <%= link_to "Check the Claude login", secretary_path(check: "claude") %>
    <% elsif @claude["error"] %>
      <p class="hint flash-alert">Couldn't run <code><%= ClaudeCli.bin %> auth status</code>: <%= @claude["error"] %></p>
    <% elsif @claude["loggedIn"] %>
      <p class="maint-summary">Signed in<%= " as #{@claude["email"]}" if @claude["email"].present? %></p>
      <p class="hint">
        <%= [ @claude["authMethod"], @claude["subscriptionType"], @claude["orgName"] ].compact_blank.join(" · ") %>
      </p>
    <% else %>
      <p class="hint flash-alert">Not signed in. On the Mac, run <code>claude auth login</code> and choose your Claude account.</p>
    <% end %>
    <% if @api_key_in_env %>
      <p class="hint">ANTHROPIC_API_KEY is set for this server. It is removed from every <code>claude</code> run so usage goes to your login, not the API.</p>
    <% end %>
  </div>
</main>
