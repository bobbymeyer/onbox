<% content_for :title, "Secretary" %>
<main class="maintenance-view">
  <nav class="maint-nav"><%= link_to "← Stack", maintenance_path %></nav>
  <h1>Secretary</h1>
  <p class="hint">Routine duties run on a local model; deeper ones on Claude through your Claude login. Set with <code>STACK_SECRETARY</code> and <code>STACK_SECRETARY_DEEP</code>: local, claude_code, api or off.</p>

  <ul class="maint-list">
    <% { routine: "Card fronts, “later”, hourly and daily digests",
         deep: "Conversation, decompose, weekly and monthly digests" }.each do |tier, duties| %>
      <li class="maint-card">
        <div class="card-meta"><span class="card-source"><%= tier %></span><span><%= @tiers[tier] %></span></div>
        <p class="maint-summary"><%= duties %></p>
        <div class="maint-actions">
          <%= button_to "Test", test_secretary_path(tier: tier), disabled: @tiers[tier] == "off" %>
        </div>
      </li>
    <% end %>
  </ul>

  <% if @local %>
    <h2>Local model</h2>
    <div class="maint-card">
      <p class="maint-summary"><%= Secretary::Backends::Local.model %> at <%= Secretary::Backends::Local.url %></p>
      <% if !@local["reachable"] %>
        <p class="hint flash-alert">Ollama isn't reachable: <%= @local["error"] %>. Install it and run <code>ollama serve</code>.</p>
      <% elsif !@local["model_ready"] %>
        <p class="hint flash-alert">Model not pulled. Run <code>ollama pull <%= Secretary::Backends::Local.model %></code>, or set <code>STACK_LOCAL_MODEL</code> to one of: <%= @local["models"].join(", ").presence || "none installed" %>.</p>
      <% else %>
        <p class="hint">Ready.</p>
      <% end %>
    </div>
  <% end %>

  <h2 id="claude">Claude</h2>
  <div class="maint-card claude-login">
    <p class="hint">Replies to Claude Code sessions<%= " and deep secretary duties" if @tiers.value?("claude_code") %> run through Claude Code on your Claude account, so they count against your Max plan.</p>

    <% if @login %>
      <ol class="login-steps">
        <li>
          <%= link_to "Sign in to Claude", @login.url, target: "_blank", rel: "noopener", class: "tool-send login-link" %>
          <span class="hint">and approve access. Claude then shows you a code.</span>
        </li>
        <li>
          <%= form_with url: claude_code_path, class: "stack-form inline-form" do |f| %>
            <%= f.text_field :code, placeholder: "Paste the code", autocomplete: "off", required: true, aria: { label: "Code from Claude" } %>
            <%= f.submit "Connect" %>
          <% end %>
        </li>
      </ol>
      <%= button_to "Cancel", cancel_claude_path, class: "defer-button" %>
      <p class="hint">This runs Claude Code's own sign-in (<code>claude setup-token</code>) on the Mac; onbox only relays the link and your code. The link is good for ten minutes.</p>
    <% elsif @credential %>
      <p class="maint-summary">Connected<%= " as #{@claude["email"]}" if @claude && @claude["email"].present? %></p>
      <p class="hint">
        Long-lived Claude Code token from <%= @credential.created_at.to_fs(:short) %>; renew before <%= @credential.expires_at.to_date.to_fs(:long) %>.
        <% if @claude && !@claude["error"] && !@claude["loggedIn"] %><span class="flash-alert">Claude Code no longer accepts it; reconnect.</span><% end %>
      </p>
      <% if @credential.expires_at < 30.days.from_now %><p class="hint flash-alert">It expires soon. Reconnect to renew it.</p><% end %>
      <div class="maint-actions">
        <%= button_to "Reconnect", connect_claude_path %>
        <%= button_to "Disconnect", disconnect_claude_path, method: :delete, class: "danger", data: { turbo_confirm: "Disconnect Claude? Replies to agents will stop until you reconnect." } %>
      </div>
    <% else %>
      <% if @claude && @claude["loggedIn"] %>
        <p class="hint">Claude Code on this Mac is already signed in (<%= [ @claude["authMethod"], @claude["subscriptionType"] ].compact_blank.join(" · ") %>), and onbox is using that. Connect here to give onbox its own login that works even when it runs as a background service.</p>
      <% else %>
        <p class="hint">Not connected.</p>
      <% end %>
      <%= button_to "Connect Claude", connect_claude_path, class: "tool-send" %>
    <% end %>

    <% if @api_key_in_env %>
      <p class="hint">ANTHROPIC_API_KEY is set for this server. It is removed from every Claude Code run so usage goes to your plan, not the API.</p>
    <% end %>
  </div>
</main>
