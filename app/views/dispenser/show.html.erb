<% content_for :title, "Stack" %>

<% if @card %>
  <%= render "cards/card", card: @card, stamps: @stamps %>
<% else %>
  <%= turbo_stream_from "stack" %>
  <main class="empty">
    <p class="empty-line">Nothing in front of you.</p>
    <p class="empty-sub">The next card will fall here on its own.</p>
    <%= link_to "Ask Claude", claude_path, class: "quiet-link" %>
    <%= link_to "Stack", maintenance_path, class: "quiet-link" %>
  </main>
<% end %>
