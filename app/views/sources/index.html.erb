<% content_for :title, "Sources" %>
<main class="maintenance-view">
  <nav class="maint-nav"><%= link_to "← Stack", maintenance_path %></nav>
  <h1>Sources</h1>
  <p class="hint">Each source POSTs JSON to <code><%= intake_url %></code> with <code>Authorization: Bearer &lt;token&gt;</code>.</p>
  <ul class="maint-list">
    <% @sources.each do |source| %>
      <li class="maint-card">
        <div class="card-meta">
          <span class="card-source"><%= source.kind %></span>
          <span><%= source.card_type %> cards</span>
        </div>
        <p class="maint-summary"><%= source.name %></p>
        <% if source.google? %>
          <% if source.connected? %>
            <p class="hint">
              Connected. <%= source.last_polled_at ? "Last checked #{time_ago_in_words(source.last_polled_at)} ago." : "Not checked yet." %>
            </p>
            <% if source.last_error %><p class="hint flash-alert"><%= source.last_error %></p><% end %>
            <% if source.email? %>
              <%= form_with model: source, class: "stack-form inline-form" do |f| %>
                <%= f.label :email_query, "Gmail search for new cards" %>
                <%= f.text_field :email_query, value: source.email_query %>
                <%= f.submit "Save search" %>
              <% end %>
            <% end %>
          <% else %>
            <p class="hint">Not connected. <%= link_to "Connect #{source.name} to Google", connect_source_path(source) %></p>
          <% end %>
        <% end %>
        <% if source.mac? %>
          <% if source.connected? %>
            <p class="hint">
              Reading the Mac's <%= source.calendar? ? "Calendar" : "Reminders" %>.
              <%= source.last_polled_at ? "Last checked #{time_ago_in_words(source.last_polled_at)} ago." : "Not checked yet." %>
            </p>
            <% if source.last_error %><p class="hint flash-alert"><%= source.last_error %></p><% end %>
            <% unless source.calendar? %>
              <%= form_with model: source, class: "stack-form inline-form" do |f| %>
                <%= f.label :reminders_list, "List that lands in the stack whole (due reminders from any list always do)" %>
                <%= f.text_field :reminders_list, value: MacReminders::Sync.list_name(source) %>
                <%= f.submit "Save list" %>
              <% end %>
            <% end %>
          <% elsif MacEventKit.available? %>
            <p class="hint">Not allowed yet. <%= button_to "Allow access to #{source.calendar? ? "Calendar" : "Reminders"}", allow_source_path(source), class: "defer-button", form_class: "inline-button" %> macOS asks on the Mac's screen; click Allow there.</p>
          <% else %>
            <p class="hint">Reads the Mac's <%= source.calendar? ? "Calendar" : "Reminders" %> when onbox runs on the Mac.</p>
          <% end %>
        <% end %>
        <details>
          <summary>Token</summary>
          <code class="token"><%= source.token %></code>
          <%= button_to "Rotate", rotate_source_path(source), form_class: "inline-button", data: { turbo_confirm: "Replace #{source.name}'s token? The old one stops working now." } %>
        </details>
        <div class="maint-actions">
          <% if source.connected? %>
            <%= button_to "Check now", poll_source_path(source) %>
            <% if source.google? %><%= link_to "Reconnect", connect_source_path(source) %><% end %>
          <% end %>
          <%= button_to "Delete", source_path(source), method: :delete, class: "danger", data: { turbo_confirm: "Delete #{source.name}? Its cards stay." } %>
        </div>
      </li>
    <% end %>
  </ul>

  <% if Source.google.exists? %>
    <h2>Google</h2>
    <%= render "sources/google_client" %>
  <% end %>

  <h2>New source</h2>
  <%= form_with model: @source, class: "stack-form" do |f| %>
    <%= render "shared/errors", record: @source %>
    <%= f.label :name %>
    <%= f.text_field :name, required: true, placeholder: "claude-code, printer, ci" %>
    <%= f.label :kind %>
    <%= f.select :kind, Source::KINDS %>
    <%= f.submit "Create source" %>
  <% end %>
</main>
