<div class="card-meta">
  <span class="card-source"><%= card.source&.name || "stack" %></span>
  <% if card.project.present? %><span class="card-project"><%= card.project %></span><% end %>
  <span class="card-ask ask-<%= card.ask %>"><%= ask_label(card) %></span>
  <time class="card-age <%= "stale" if stale?(card) %>"><%= card_age(card) %></time>
</div>
<p class="maint-summary"><%= card.summary %></p>
<% if card.blocked? %><p class="hint">Waits on: <%= card.blocked_by.summary %></p><% end %>
