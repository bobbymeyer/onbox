<%= form_with model: stamp, class: "stack-form" do |f| %>
  <%= render "shared/errors", record: stamp %>
  <%= f.label :label %>
  <%= f.text_field :label, required: true %>
  <%= f.label :card_type, "Card type" %>
  <%= f.select :card_type, [ "any", *CardType::NAMES ] %>
  <%= f.label :template, "Message template" %>
  <%= f.text_area :template, rows: 3, placeholder: "Blank sends the card's proposed action. {{project}} and {{summary}} are filled in." %>
  <%= f.label :action_json, "Action (JSON)" %>
  <%= f.text_area :action_json, rows: 3, class: "mono", placeholder: '{ "kind": "instruct" }' %>
  <p class="hint">kind: instruct (send to agent), reply, or handle (just close). Optional "repeat": "1 week" re-seeds the card.</p>
  <%= f.label :successors_json, "Successors (JSON)" %>
  <%= f.text_area :successors_json, rows: 6, class: "mono" %>
  <p class="hint">Cards this stamp seeds, in order. Each waits on the one before it unless "parallel": true. Fields: summary, ask, project, proposed_action, card_type, later.</p>
  <label class="check"><%= f.check_box :requires_flip %> Flip before sending (irreversible actions)</label>
  <%= f.submit %>
<% end %>
