#!/usr/bin/env ruby
# Stands in for the claude CLI in tests: reports what it was given.
require "json"
input = ARGV.first == "setup-token" ? "" : $stdin.read
seen = { "args" => ARGV, "stdin" => input, "oauth_token" => ENV["CLAUDE_CODE_OAUTH_TOKEN"], "api_key" => ENV["ANTHROPIC_API_KEY"], "internal" => ENV["STACK_INTERNAL"], "cwd" => Dir.pwd }
if ARGV.first == "setup-token"
  # Like the real CLI: a challenge per sign-in, codes arrive as "code#state",
  # and a rejected code leaves it waiting on "Press Enter to retry".
  require "securerandom"
  state = SecureRandom.hex(4)
  url = "https://claude.com/cai/oauth/authorize?code=true&client_id=fake&code_challenge=#{SecureRandom.hex(8)}&state=#{state}"
  print "Welcome to Claude Code\r\n\e]8;;#{url}\a#{url}\e]8;;\a\r\nPaste code here if prompted > "
  $stdout.flush
  code = $stdin.gets.to_s.strip
  if code == "good##{state}"
    puts "\r\nYour OAuth token (valid for 1 year):\r\n\r\nsk-ant-oat01-#{"a" * 90}\r\n"
  else
    print "\r\nOAuth error: Request failed with status code 400\r\nPress Enter to retry."
    $stdout.flush
    $stdin.gets
    sleep 30
  end
elsif ARGV.first == "auth"
  puts({ "loggedIn" => true, "authMethod" => "claude.ai", "subscriptionType" => "max", "email" => "bobby@example.com" }.to_json)
elsif ENV["FAKE_CLAUDE_FAIL"]
  warn "Not logged in"
  exit 1
elsif ARGV.include?("--output-format") && ARGV.include?("json") && !ARGV.include?("--json-schema")
  # A headless turn: the prompt on stdin, the reply as a JSON result.
  File.write(ENV.fetch("FAKE_CLAUDE_LOG"), seen.merge("launched" => ENV["STACK_LAUNCHED"], "run_id" => ENV["STACK_RUN_ID"], "tool_timeout" => ENV["MCP_TOOL_TIMEOUT"]).to_json) if ENV["FAKE_CLAUDE_LOG"]
  sleep Float(ENV["FAKE_CLAUDE_SLEEP"]) if ENV["FAKE_CLAUDE_SLEEP"]
  resumed = ARGV[ARGV.index("--resume") + 1] if ARGV.include?("--resume")
  if input.include?("fail")
    puts({ "type" => "result", "is_error" => true, "result" => "Credit balance is too low", "session_id" => resumed || "sess-new" }.to_json)
    exit 1
  end
  puts({ "type" => "result", "subtype" => "success", "is_error" => false, "result" => "Done: #{input.strip}\n\nAll tests pass.",
         "session_id" => resumed || "sess-new", "total_cost_usd" => 0.12 }.to_json)
elsif ARGV.include?("--json-schema")
  puts({ "type" => "result", "is_error" => false, "result" => "", "structured_output" => { "reply" => "hi", "seen" => seen } }.to_json)
else
  File.write(ENV.fetch("FAKE_CLAUDE_LOG"), seen.to_json) if ENV["FAKE_CLAUDE_LOG"]
  puts "ok"
end
